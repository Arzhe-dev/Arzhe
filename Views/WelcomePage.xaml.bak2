<UserControl x:Class="Arzhe.Views.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True">

    <Grid>
        <!-- ============================================ -->
        <!--  AURORE BOREALE EN FOND                      -->
        <!-- ============================================ -->
        <Canvas ClipToBounds="True">
            <Ellipse x:Name="Aurora1" Width="700" Height="700"
                     Canvas.Left="-200" Canvas.Top="-150"
                     Opacity="0.25">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7C5CFF" Offset="0"/>
                        <GradientStop Color="#7C5CFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="120"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Aurora2" Width="600" Height="600"
                     Canvas.Left="500" Canvas.Top="100"
                     Opacity="0.2">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A78BFA" Offset="0"/>
                        <GradientStop Color="#A78BFA" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="120"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Aurora3" Width="500" Height="500"
                     Canvas.Left="200" Canvas.Top="400"
                     Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#64DCFF" Offset="0"/>
                        <GradientStop Color="#64DCFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="120"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- ============================================ -->
        <!--  PARTICULES FLOTTANTES                       -->
        <!-- ============================================ -->
        <Canvas x:Name="ParticlesCanvas" ClipToBounds="True"/>

        <!-- ============================================ -->
        <!--  CONTENU PRINCIPAL                           -->
        <!-- ============================================ -->
        <StackPanel x:Name="MainStack"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!-- Logo Lune -->
            <Image x:Name="LogoImage"
                   Source="/Resources/arzhe_moon_256.png"
                   Width="180" Height="180"
                   HorizontalAlignment="Center"
                   Opacity="0"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="LogoScale"
                                    ScaleX="0.5" ScaleY="0.5"
                                    CenterX="90" CenterY="90"/>
                </Image.RenderTransform>
                <Image.Effect>
                    <DropShadowEffect Color="#7C5CFF" BlurRadius="60"
                                      ShadowDepth="0" Opacity="0.8"/>
                </Image.Effect>
            </Image>

            <!-- Titre Arzhe -->
            <TextBlock x:Name="TitleText"
                       Text="Arzhe"
                       FontSize="64" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,24,0,0"
                       Opacity="0"
                       Foreground="{StaticResource AccentGradient}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#7C5CFF" BlurRadius="30"
                                      ShadowDepth="0" Opacity="0.7"/>
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleTranslate" Y="20"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Sous-titre -->
            <TextBlock x:Name="SubtitleText"
                       Text="Optimiseur Gaming Premium"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#B3FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="SubtitleTranslate" Y="20"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Metadonnees -->
            <StackPanel x:Name="MetaPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,32,0,0"
                        Opacity="0">
                <TextBlock Text="35 optimisations" FontSize="12" Foreground="#80FFFFFF"/>
                <TextBlock Text="  •  " FontSize="12" Foreground="#60FFFFFF"/>
                <TextBlock Text="100% reversible" FontSize="12" Foreground="#80FFFFFF"/>
                <TextBlock Text="  •  " FontSize="12" Foreground="#60FFFFFF"/>
                <TextBlock Text="Windows 10/11" FontSize="12" Foreground="#80FFFFFF"/>
            </StackPanel>

            <!-- Bouton Demarrer -->
            <Button x:Name="StartButton"
                    Content="Demarrer l'analyse"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0"
                    Opacity="0"
                    Padding="36,18"
                    FontSize="16"
                    Click="Start_Click">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="ButtonTranslate" Y="20"/>
                </Button.RenderTransform>
            </Button>

            <!-- Note admin -->
            <TextBlock x:Name="AdminNote"
                       Text="Necessite les droits administrateur"
                       FontSize="11" Foreground="#66FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,24,0,0"
                       Opacity="0"/>
        </StackPanel>
    </Grid>
</UserControl>