<UserControl x:Class="Arzhe.Views.FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="OK" FontSize="110" FontWeight="Bold"
                       Foreground="{StaticResource AccentGradient}"
                       HorizontalAlignment="Center">
                <TextBlock.RenderTransform>
                    <ScaleTransform x:Name="CheckScale" ScaleX="0" ScaleY="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock Text="Optimisation terminee !" FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,20,0,8"/>

            <TextBlock Text="Votre systeme est maintenant optimise pour le gaming."
                       FontSize="15" Foreground="#B3FFFFFF"
                       HorizontalAlignment="Center" Margin="0,0,0,40"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Voir le rapport" Style="{StaticResource GhostButton}"
                        Margin="0,0,12,0" Click="Report_Click"/>
                <Button Content="Quitter" Style="{StaticResource PrimaryButton}"
                        Click="Quit_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>