<UserControl x:Class="Arzhe.Views.FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Background="#FF0A0B0F">

    <Grid>
        <!-- Fond -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.3" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#1F1A50" Offset="0"/>
                    <GradientStop Color="#15173A" Offset="0.5"/>
                    <GradientStop Color="#0A0B0F" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Confetti -->
        <Canvas x:Name="ConfettiCanvas"
                ClipToBounds="True"
                IsHitTestVisible="False"/>

        <!-- Contenu principal -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Grand check -->
            <Grid Width="140" Height="140">
                <!-- Cercle externe lumineux -->
                <Ellipse x:Name="CheckHalo"
                         Fill="#7C5CFF"
                         Opacity="0">
                    <Ellipse.Effect>
                        <BlurEffect Radius="40"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Cercle principal -->
                <Ellipse x:Name="CheckCircle"
                         Width="140" Height="140"
                         Fill="{StaticResource AccentGradient}"
                         Opacity="0">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="CheckScale"
                                        ScaleX="0" ScaleY="0"
                                        CenterX="70" CenterY="70"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#7C5CFF" BlurRadius="50"
                                          ShadowDepth="0" Opacity="0.7"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Check blanc centre par Viewbox -->
                <Viewbox Width="80" Height="80"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Canvas Width="100" Height="100">
                        <Path x:Name="CheckMark"
                              Data="M 20,55 L 42,77 L 80,20"
                              Stroke="White"
                              StrokeThickness="12"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Canvas.Left="0"
                              Canvas.Top="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform x:Name="CheckMarkScale"
                                                ScaleX="0" ScaleY="0"
                                                CenterX="50" CenterY="50"/>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Titre -->
            <TextBlock x:Name="TitleText"
                       Text="Optimisation terminee !"
                       FontSize="36" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,32,0,0"
                       Opacity="0"
                       Foreground="White">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#7C5CFF" BlurRadius="20"
                                      ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleTranslate" Y="20"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="SubtitleText"
                       Text="Votre systeme est maintenant optimise pour le gaming."
                       FontSize="15"
                       Foreground="#B3FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Opacity="0"/>

            <!-- Stats -->
            <StackPanel x:Name="StatsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,40,0,0"
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="StatsTranslate" Y="20"/>
                </StackPanel.RenderTransform>

                <!-- Card succes -->
                <Border Style="{StaticResource GlassCard}"
                        Padding="28,16"
                        Margin="0,0,12,0"
                        MinWidth="130">
                    <StackPanel>
                        <TextBlock x:Name="SuccessCountText"
                                   Text="0"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="#4ADE80"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Succes"
                                   FontSize="11"
                                   Foreground="#B3FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card avertissements -->
                <Border Style="{StaticResource GlassCard}"
                        Padding="28,16"
                        Margin="0,0,12,0"
                        MinWidth="130">
                    <StackPanel>
                        <TextBlock x:Name="WarningCountText"
                                   Text="0"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="#FBBF24"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Avertissements"
                                   FontSize="11"
                                   Foreground="#B3FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card duree -->
                <Border Style="{StaticResource GlassCard}"
                        Padding="28,16"
                        MinWidth="130">
                    <StackPanel>
                        <TextBlock x:Name="DurationText"
                                   Text="0s"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource Accent2Brush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Duree"
                                   FontSize="11"
                                   Foreground="#B3FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Boutons -->
            <StackPanel x:Name="ButtonsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,48,0,0"
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ButtonsTranslate" Y="20"/>
                </StackPanel.RenderTransform>

                <Button Content="Exporter le rapport"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,12,0"
                        Padding="20,12"
                        Click="Report_Click"/>

                <Button Content="Quitter"
                        Style="{StaticResource PrimaryButton}"
                        Click="Quit_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>