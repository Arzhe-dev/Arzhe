<UserControl x:Class="Arzhe.Views.SystemAnalysisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Background="#FF0A0B0F">

    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#15173A" Offset="0"/>
                    <GradientStop Color="#0A0B0F" Offset="0.7"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="48,32,48,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TETE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="HeaderTitle"
                           Text="Analyse du systeme"
                           FontSize="32" FontWeight="Bold"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="HeaderTranslate" Y="20"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="HeaderSubtitle"
                           Text="Detection du materiel et de la configuration..."
                           FontSize="14" Foreground="#B3FFFFFF"
                           Margin="0,8,0,0"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="SubtitleTranslate" Y="20"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>

            <!-- BARRE DE PROGRESSION -->
            <Border x:Name="MainProgressBorder"
                    Grid.Row="1"
                    Style="{StaticResource GlassCard}"
                    Margin="0,0,0,24"
                    Opacity="0">
                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               Text="Initialisation..."
                               FontSize="15"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <!-- Barre : Grid avec colonne proportionnelle -->
                    <Grid Height="8">
                        <Border Background="#1AFFFFFF" CornerRadius="4"/>
                        <Grid x:Name="ProgressGrid" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProgressFill"
                                    Grid.Column="0"
                                    Background="{StaticResource AccentGradient}"
                                    CornerRadius="4"
                                    Width="0"/>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="PercentText"
                               Text="0 %"
                               FontSize="13"
                               Foreground="#B3FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- CARTES -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CardsContainer"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"
                                       IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}"
                                    Width="270" Height="120"
                                    Margin="8"
                                    CacheMode="BitmapCache">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.RenderTransformOrigin>
                                    <Point X="0.5" Y="0.5"/>
                                </Border.RenderTransformOrigin>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0" To="1"
                                                    Duration="0:0:0.35"/>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                    From="0.5" To="1"
                                                    Duration="0:0:0.5">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                    From="0.5" To="1"
                                                    Duration="0:0:0.5">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#22FFFFFF"
                                            CornerRadius="10"
                                            Width="52" Height="52"
                                            VerticalAlignment="Center"
                                            Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource Accent2Brush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   Foreground="#80FFFFFF"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Value}"
                                                   FontSize="13"
                                                   Foreground="White"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- BOUTON -->
            <Button x:Name="NextButton"
                    Grid.Row="3"
                    Content="Continuer"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0"
                    Opacity="0"
                    IsEnabled="False"
                    Click="Next_Click">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="ButtonTranslate" Y="20"/>
                </Button.RenderTransform>
            </Button>
        </Grid>
    </Grid>
</UserControl>