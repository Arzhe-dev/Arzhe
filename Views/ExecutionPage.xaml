<UserControl x:Class="Arzhe.Views.ExecutionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Background="#FF0A0B0F">

    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#15173A" Offset="0"/>
                    <GradientStop Color="#0A0B0F" Offset="0.7"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="48,32,48,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="HeaderTitle"
                           Text="Optimisation en cours"
                           FontSize="32" FontWeight="Bold"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="HeaderTranslate" Y="20"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="HeaderSubtitle"
                           Text="Application des parametres selectionnes..."
                           FontSize="14" Foreground="#B3FFFFFF"
                           Margin="0,8,0,0"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="SubtitleTranslate" Y="20"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>

            <Border x:Name="ProgressCard"
                    Grid.Row="1"
                    Style="{StaticResource GlassCard}"
                    Margin="0,0,0,20"
                    Opacity="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cercle de progression : GRID 120x120 -->
                    <Grid Grid.Column="0"
                          Width="120" Height="120"
                          Margin="0,0,24,0"
                          ClipToBounds="True">

                        <!-- Canvas 120x120 pour tracer le cercle en coordonnees absolues -->
                        <Canvas Width="120" Height="120"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ClipToBounds="True">

                            <!-- Cercle de fond -->
                            <Ellipse Canvas.Left="10" Canvas.Top="10"
                                     Width="100" Height="100"
                                     Stroke="#2AFFFFFF"
                                     StrokeThickness="8"/>

                            <!-- Arc de progression (coordonnees absolues dans le Canvas) -->
                            <Path x:Name="ProgressArc"
                                  Stroke="{StaticResource Accent2Brush}"
                                  StrokeThickness="8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Canvas>

                        <!-- Pourcentage au centre -->
                        <TextBlock x:Name="PercentText"
                                   Text="0%"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentTaskText"
                                   Text="Preparation..."
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock x:Name="CurrentStepText"
                                   Text="Initialisation du processus"
                                   FontSize="13" Foreground="#B3FFFFFF"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="ProgressDetailText"
                                   Text=""
                                   FontSize="11" Foreground="#80FFFFFF"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource GlassCard}"
                    Padding="20,16"
                    Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="LogTranslate" Y="20"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8"
                                     Fill="#4ADE80"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="1" To="0.3" Duration="0:0:0.8"
                                                    AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="JOURNAL D'EXECUTION"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#B3FFFFFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="LogLineCount"
                                   Grid.Column="1"
                                   Text="0 lignes"
                                   FontSize="11"
                                   Foreground="#66FFFFFF"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer x:Name="LogScroll"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LogPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Button x:Name="NextButton"
                    Grid.Row="3"
                    Content="Terminer"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0"
                    Opacity="0"
                    IsEnabled="False"
                    Click="Next_Click">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="ButtonTranslate" Y="20"/>
                </Button.RenderTransform>
            </Button>
        </Grid>
    </Grid>
</UserControl>