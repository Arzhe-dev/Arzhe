<UserControl x:Class="Arzhe.Views.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True">

    <Grid>
        <!-- Aurore boreale FIXE (pas d'animation) -->
        <Border ClipToBounds="True">
            <Border.Background>
                <RadialGradientBrush Center="0.3,0.3" RadiusX="0.6" RadiusY="0.6">
                    <GradientStop Color="#7C5CFF" Offset="0"/>
                    <GradientStop Color="#0A0B0F" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Contenu principal -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <Image x:Name="LogoImage"
                   Source="/Resources/arzhe_moon_256.png"
                   Width="160" Height="160"
                   HorizontalAlignment="Center"
                   Opacity="0">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="LogoScale"
                                    ScaleX="0.5" ScaleY="0.5"
                                    CenterX="80" CenterY="80"/>
                </Image.RenderTransform>
                <Image.Effect>
                    <DropShadowEffect Color="#7C5CFF" BlurRadius="40"
                                      ShadowDepth="0" Opacity="0.7"/>
                </Image.Effect>
            </Image>

            <TextBlock x:Name="TitleText"
                       Text="Arzhe"
                       FontSize="60" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       Opacity="0"
                       Foreground="{StaticResource AccentGradient}">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleTranslate" Y="20"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="SubtitleText"
                       Text="Optimiseur Gaming Premium"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#B3FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="SubtitleTranslate" Y="20"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <StackPanel x:Name="MetaPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,28,0,0"
                        Opacity="0">
                <TextBlock Text="35 optimisations" FontSize="12" Foreground="#80FFFFFF"/>
                <TextBlock Text="  •  " FontSize="12" Foreground="#60FFFFFF"/>
                <TextBlock Text="100% reversible" FontSize="12" Foreground="#80FFFFFF"/>
                <TextBlock Text="  •  " FontSize="12" Foreground="#60FFFFFF"/>
                <TextBlock Text="Windows 10/11" FontSize="12" Foreground="#80FFFFFF"/>
            </StackPanel>

            <Button x:Name="StartButton"
                    Content="Demarrer l'analyse"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center"
                    Margin="0,36,0,0"
                    Opacity="0"
                    Padding="32,16"
                    FontSize="15"
                    Click="Start_Click">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="ButtonTranslate" Y="20"/>
                </Button.RenderTransform>
            </Button>

            <TextBlock x:Name="AdminNote"
                       Text="Necessite les droits administrateur"
                       FontSize="11" Foreground="#66FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       Opacity="0"/>
        </StackPanel>
    </Grid>
</UserControl>