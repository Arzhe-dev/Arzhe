<UserControl x:Class="Arzhe.Views.OptimizationSelectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Background="#FF0A0B0F">

    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#15173A" Offset="0"/>
                    <GradientStop Color="#0A0B0F" Offset="0.7"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="48,32,48,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TETE -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="HeaderTitle"
                               Text="Modules d'optimisation"
                               FontSize="32" FontWeight="Bold"
                               Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="HeaderTranslate" Y="20"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="HeaderSubtitle"
                               Text="Selectionnez les ajustements a appliquer. Tous sont reversibles."
                               FontSize="14" Foreground="#B3FFFFFF"
                               Margin="0,8,0,0"
                               Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="SubtitleTranslate" Y="20"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>

                <!-- Compteur global -->
                <Border Grid.Column="1"
                        x:Name="CounterBorder"
                        Background="#0FFFFFFF"
                        BorderBrush="#1FFFFFFF"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20,14"
                        VerticalAlignment="Center"
                        Opacity="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="CounterText"
                                       Text="0"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource Accent2Brush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" / "
                                       FontSize="20" Foreground="#80FFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="4,0"/>
                            <TextBlock x:Name="CounterTotal"
                                       Text="0"
                                       FontSize="20"
                                       Foreground="#80FFFFFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="modules actifs"
                                   FontSize="10"
                                   Foreground="#80FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BARRE PROGRESSION + PRESETS -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Barre progression -->
                <Grid Grid.Column="0" x:Name="ProgressBorder" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Height="6" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border Background="#1AFFFFFF" CornerRadius="3"/>
                        <Grid x:Name="ProgressGrid" HorizontalAlignment="Left">
                            <Border x:Name="ProgressFill"
                                    Background="{StaticResource AccentGradient}"
                                    CornerRadius="3"
                                    Width="0"
                                    Height="6"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Presets -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            x:Name="PresetsPanel"
                            Opacity="0">
                    <Button Content="Sur uniquement"
                            Style="{StaticResource GhostButton}"
                            Padding="14,8"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="PresetSafe_Click"/>
                    <Button Content="Recommande"
                            Style="{StaticResource GhostButton}"
                            Padding="14,8"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="PresetRecommended_Click"/>
                    <Button Content="Tout"
                            Style="{StaticResource GhostButton}"
                            Padding="14,8"
                            FontSize="12"
                            Click="PresetAll_Click"/>
                </StackPanel>
            </Grid>

            <!-- LISTE DES OPTIMISATIONS -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="OptionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Carte -->
                            <Border Style="{StaticResource GlassCard}"
                                    Margin="0,0,0,10"
                                    Opacity="{Binding CardOpacity}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="Card_Click">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0" To="{Binding CardOpacity}"
                                                    Duration="0:0:0.4"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="FrameworkElement.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                    To="1.012" Duration="0:0:0.15"/>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                    To="1.012" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="FrameworkElement.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                    To="1" Duration="0:0:0.15"/>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                    To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.RenderTransformOrigin>
                                    <Point X="0.5" Y="0.5"/>
                                </Border.RenderTransformOrigin>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icone -->
                                    <Border Background="#22FFFFFF"
                                            CornerRadius="12"
                                            Width="54" Height="54"
                                            VerticalAlignment="Center"
                                            Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource Accent2Brush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Infos -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                            <Border Background="{Binding RiskBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.85">
                                                <TextBlock Text="{Binding RiskLabel}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#FF0A0B0F"/>
                                            </Border>
                                            <Border Background="#22FFFFFF"
                                                    CornerRadius="6"
                                                    Padding="8,2"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryLabel}"
                                                           FontSize="10"
                                                           Foreground="#B3FFFFFF"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="#B3FFFFFF"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,16,0"/>

                                        <TextBlock Text="{Binding UnavailableReason}"
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   Foreground="#FFB36B"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,16,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailableForPc}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Toggle iOS -->
                                    <ToggleButton Grid.Column="2"
                                                  Style="{StaticResource ArzheToggle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsAvailableForPc}"
                                                  VerticalAlignment="Center"
                                                  Click="Toggle_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- BOUTONS BAS -->
            <StackPanel x:Name="ButtonsPanel"
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0"
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ButtonsTranslate" Y="20"/>
                </StackPanel.RenderTransform>
                <Button Content="Tout decocher"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0"
                        Click="DeselectAll_Click"/>
                <Button Content="Tout cocher"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,12,0"
                        Click="SelectAll_Click"/>
                <Button Content="Lancer l'optimisation"
                        Style="{StaticResource PrimaryButton}"
                        Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>