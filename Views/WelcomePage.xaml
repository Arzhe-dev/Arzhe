<UserControl x:Class="Arzhe.Views.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arzhe.Controls"
             ClipToBounds="True"
             Background="#FF0A0B0F">

    <Grid>
        <!-- Fond RadialGradient -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.3,0.25" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#2A2050" Offset="0"/>
                    <GradientStop Color="#15173A" Offset="0.4"/>
                    <GradientStop Color="#0A0B0F" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Aurores flottantes -->
        <Canvas ClipToBounds="True" IsHitTestVisible="False">
            <Image x:Name="Aurora1"
                   Source="/Resources/Assets/aurora_violet.png"
                   Width="900" Height="900"
                   Canvas.Left="-250" Canvas.Top="-200"
                   Opacity="0.5"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="Aurora1Translate"/>
                </Image.RenderTransform>
            </Image>

            <Image x:Name="Aurora2"
                   Source="/Resources/Assets/aurora_purple.png"
                   Width="800" Height="800"
                   Canvas.Left="500" Canvas.Top="100"
                   Opacity="0.45"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="Aurora2Translate"/>
                </Image.RenderTransform>
            </Image>

            <Image x:Name="Aurora3"
                   Source="/Resources/Assets/aurora_cyan.png"
                   Width="700" Height="700"
                   Canvas.Left="200" Canvas.Top="350"
                   Opacity="0.35"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="Aurora3Translate"/>
                </Image.RenderTransform>
            </Image>
        </Canvas>

        <!-- Particules -->
        <Canvas x:Name="ParticlesCanvas"
                ClipToBounds="True"
                IsHitTestVisible="False"/>

        <!-- Contenu principal - parfaitement centre -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="Auto">

            <!-- Logo Lune -->
            <Image x:Name="LogoImage"
                   Source="/Resources/arzhe_dark_256.png"
                   Width="180" Height="180"
                   HorizontalAlignment="Center"
                   Opacity="0"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="LogoScale"
                                    ScaleX="0.5" ScaleY="0.5"
                                    CenterX="90" CenterY="90"/>
                </Image.RenderTransform>
                <Image.RenderTransformOrigin>
                    <Point X="0.5" Y="0.5"/>
                </Image.RenderTransformOrigin>
                <Image.Effect>
                    <DropShadowEffect Color="#7C5CFF" BlurRadius="50"
                                      ShadowDepth="0" Opacity="0.7"/>
                </Image.Effect>
            </Image>

            <!-- Titre Arzhe -->
            <TextBlock x:Name="TitleText"
                       Text="Arzhe"
                       FontSize="64" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,24,0,0"
                       Opacity="0"
                       Foreground="{StaticResource AccentGradient}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#7C5CFF" BlurRadius="25"
                                      ShadowDepth="0" Opacity="0.6"/>
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <ScaleTransform x:Name="TitleScale"
                                    ScaleX="1" ScaleY="1"
                                    CenterX="100" CenterY="40"/>
                </TextBlock.RenderTransform>
                <TextBlock.RenderTransformOrigin>
                    <Point X="0.5" Y="0.5"/>
                </TextBlock.RenderTransformOrigin>
            </TextBlock>

            <!-- Sous-titre -->
            <TextBlock x:Name="SubtitleText"
                       Text="Optimiseur Gaming Premium"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#B3FFFFFF"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,8,0,0"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <ScaleTransform x:Name="SubtitleScale"
                                    ScaleX="1" ScaleY="1"/>
                </TextBlock.RenderTransform>
                <TextBlock.RenderTransformOrigin>
                    <Point X="0.5" Y="0.5"/>
                </TextBlock.RenderTransformOrigin>
            </TextBlock>

            <!-- Meta -->
            <StackPanel x:Name="MetaPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,32,0,0"
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="MetaScale"
                                    ScaleX="1" ScaleY="1"/>
                </StackPanel.RenderTransform>
                <StackPanel.RenderTransformOrigin>
                    <Point X="0.5" Y="0.5"/>
                </StackPanel.RenderTransformOrigin>
                <TextBlock Text="35 optimisations" FontSize="12" Foreground="#80FFFFFF"/>
                <TextBlock Text="  •  " FontSize="12" Foreground="#60FFFFFF"/>
                <TextBlock Text="100% reversible" FontSize="12" Foreground="#80FFFFFF"/>
                <TextBlock Text="  •  " FontSize="12" Foreground="#60FFFFFF"/>
                <TextBlock Text="Windows 10/11" FontSize="12" Foreground="#80FFFFFF"/>
            </StackPanel>

            <!-- Bouton Demarrer -->
            <controls:RippleButton x:Name="StartButton"
                    Content="Demarrer l'analyse"
                    Style="{StaticResource RipplePrimaryButton}"
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0"
                    Opacity="0"
                    Padding="36,18"
                    FontSize="16"
                    Click="Start_Click">
                <Button.RenderTransform>
                    <ScaleTransform x:Name="ButtonScale"
                                    ScaleX="1" ScaleY="1"/>
                </Button.RenderTransform>
                <Button.RenderTransformOrigin>
                    <Point X="0.5" Y="0.5"/>
                </Button.RenderTransformOrigin>
            </controls:RippleButton>

            <!-- Note admin -->
            <TextBlock x:Name="AdminNote"
                       Text="Necessite les droits administrateur"
                       FontSize="11" Foreground="#66FFFFFF"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,24,0,0"
                       Opacity="0"/>
        </StackPanel>
    </Grid>
</UserControl>