<Window x:Class="Arzhe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Arzhe - Optimiseur Gaming"
        Height="760" Width="1180"
        WindowStyle="None"
        Background="#FF0A0B0F"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- WindowChrome : rendu GPU avec coins arrondis -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Bordure exterieure avec coins arrondis -->
    <Border CornerRadius="20"
            Background="#FF0A0B0F"
            BorderBrush="#1FFFFFFF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre de titre personnalisee -->
            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0">
                    <TextBlock Text="Arzhe"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="  •  Optimiseur Gaming"
                               FontSize="12"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"
                               Margin="4,2,0,0"/>
                </StackPanel>

                <!-- Boutons de fenetre -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—"
                            Width="48" Height="52"
                            Click="Minimize_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Style="{StaticResource CaptionButtonStyle}"/>
                    <Button Content="✕"
                            Width="48" Height="52"
                            Click="Close_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Style="{StaticResource CloseButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Conteneur des vues avec transitions -->
            <ContentControl x:Name="MainFrame"
                            Grid.Row="1"
                            Margin="0"
                            Opacity="1">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="FrameTranslate" X="0"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>
    </Border>
</Window>