<Window x:Class="Arzhe.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Arzhe"
        Width="520" Height="320"
        WindowStyle="None"
        Background="#FF0A0B0F"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="24"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="24"
            Background="#FF0A0B0F"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Grid>
            <!-- Aurore en fond -->
            <Border CornerRadius="24" ClipToBounds="True">
                <Canvas>
                    <Ellipse x:Name="Aurora1" Width="500" Height="500"
                             Canvas.Left="-200" Canvas.Top="-100"
                             Fill="#7C5CFF" Opacity="0.15">
                        <Ellipse.Effect>
                            <BlurEffect Radius="80"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse x:Name="Aurora2" Width="400" Height="400"
                             Canvas.Left="200" Canvas.Top="50"
                             Fill="#A78BFA" Opacity="0.12">
                        <Ellipse.Effect>
                            <BlurEffect Radius="80"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Border>

            <!-- Contenu -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <Image Source="/Resources/arzhe_dark_256.png"
                       Width="120" Height="120"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="LogoScale"
                                        ScaleX="0.8" ScaleY="0.8"
                                        CenterX="60" CenterY="60"/>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect Color="#7C5CFF" BlurRadius="50"
                                          ShadowDepth="0" Opacity="0.8"/>
                    </Image.Effect>
                </Image>

                <TextBlock Text="Arzhe"
                           FontSize="40" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"
                           Foreground="{StaticResource AccentGradient}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#7C5CFF" BlurRadius="20"
                                          ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="Optimiseur Gaming"
                           FontSize="12" Foreground="#B3FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           FontWeight="SemiBold"/>

                <Border x:Name="LoadingTrack"
                        Width="200" Height="4"
                        Background="#1AFFFFFF"
                        CornerRadius="2"
                        Margin="0,32,0,0">
                    <Border x:Name="LoadingBar"
                            Width="0" Height="4"
                            Background="{StaticResource AccentGradient}"
                            CornerRadius="2"
                            HorizontalAlignment="Left"/>
                </Border>

                <TextBlock x:Name="LoadingText"
                           Text="Initialisation..."
                           FontSize="11" Foreground="#66FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>